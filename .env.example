# Em contentores/hosting publica com HOST=0.0.0.0.
# Em produção com HTTPS define COOKIE_SECURE=1.
HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=0
DB_PATH=data/stop.db

# Domínio público (sem barra final). Em Render é detetado automaticamente
# através de RENDER_EXTERNAL_URL; define aqui se usares outro hosting.
# Exemplo: https://kweha.onrender.com
PUBLIC_URL=

# Cria as credenciais em:
#   https://console.cloud.google.com/apis/credentials
#
# O redirect URI tem de ser exatamente igual ao registado no Google.
# Em desenvolvimento podes deixá-lo vazio: o servidor usa automaticamente
# http://<host>:<porta>/api/auth/google/callback (apenas em localhost).
# Exemplo:
#   http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
